#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdint.h>

#define PD2_DIR PD2
#define PD3_BRAKE PD3
#define PD6_PWM PD6
#define PD4_TRN PD4
#define BAUD 115200
#define MYUBRR (F_CPU/8/BAUD - 1)

uint8_t MAX_PERCENT = 128;
uint16_t TURN_LEFT = 2000;
uint16_t TURN_RIGHT = 4000;
uint16_t TURN_NEUTRAL = 3000;



void pwn_init(void) {
	TCCR2A = (1 << WGM21) | (1 << WGM20) | (1 << COM2B1);
	TCCR2B = (1 << WGM22) | (1 << CS21) | (1 << CS20);
	OCR2A = MAX_PERCENT;
	OCR2B = 0;
	DDRD |= (1 << PD2_DIR) | (1 << PD3_BRAKE) | (1 << PD6_PWM);
}

void set_gas_percent(uint8_t percent, uint8_t dir) {
	PORTD &= ~(1 << PD3_BRAKE);
	
	if (dir == 0) {
		PORTD &= ~(1 << PD2_DIR);
	} else if (dir == 1) {
		PORTD |= (1 << PD2_DIR);
	}
	
	if (percent > 100) percent = 100;
	OCR2B = (uint16_t)percent*MAX_PERCENT/100;
}

void trn_init(void) {
    TCCR1A = (1 << COM1B1) | (1 << WGM11);
    TCCR1B = (1 << WGM13) | (1 << WGM12);
	
	ICR1 = 39999;
	
	OCR1B = TURN_NEUTRAL;

	DDRD |= (1 << PD4_TRN);
	
	TCCR1B |= (1 << CS11);
}

void uart_init(void) {
	UCSR0A = (1 << U2X0);
	UBRR0H = (uint8_t)(MYUBRR >> 8);
	UBRR0L = (uint8_t)MYUBRR;
	
    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

uint8_t uart_reciever() {
	while(!(UCSR0A & (1 << RXC0)));
	return UDR0;
}

void stop() {
	PORTD |= (1 << PD3_BRAKE);
}

void set_turn_value(uint8_t percent) {
	if (percent < 100) {
		uint16_t turn_value = TURN_LEFT + 20 * percent;
		OCR1B = turn_value;	
	} else {
		OCR1B = TURN_RIGHT;
	}
}

int main(void)
{
	pwn_init();
	trn_init();
	uart_init();
	
	while (1) {
		uint8_t data;
		data = uart_reciever();
		uint8_t speed = (data >> 7) & 0x01;
		uint8_t stopping = (data >> 6) & 0x01;
		uint8_t left = (data >> 5) & 0x01;
		uint8_t right = (data >> 4) & 0x01;
		uint8_t reverse = (data >> 3) & 0x01;
		
		if (stopping) {
			stop();
		}
		else if (speed) {
			set_gas_percent(80, 0);
		}
		else if (reverse) {
			set_gas_percent(80,1);
		}
		else {
			set_gas_percent(0, 0);
		}

		if (left) {
			set_turn_value(0);
		}
		else if (right) {
			set_turn_value(100);
			
		}
		else {
			set_turn_value(50);
		}
	}
}